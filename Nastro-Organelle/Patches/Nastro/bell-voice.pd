#N canvas 40 40 1400 800 12;
#X text 20 5 bell-voice: 4 partials with their own decays (higher = shorter) - harmonic <-> inharmonic - beating twins;
#X obj 20 40 inlet;
#X obj 700 600 switch~;
#X msg 800 570 0;
#X obj 800 540 loadbang;
#X obj 700 540 delay;
#X msg 760 510 1;
#X msg 820 510 stop;
#X obj 700 480 f 1000;
#X obj 700 510 + 300;
#X obj 900 420 r bell-dec;
#X obj 700 420 unpack f f;
#X obj 700 450 moses 1;
#X obj 760 480 t b b b;
#X obj 20 70 unpack f f;
#X obj 20 130 spigot;
#X obj 120 100 > 0;
#X obj 20 170 expr $f1*((1-$f5)*1+$f5*1) \; sqrt($f2/127*1*pow($f4 \, 0)) \; $f3/(1+1.4*0) \; $f1*((1-$f5)*2+$f5*2.76) \; sqrt($f2/127*0.6*pow($f4 \, 1)) \; $f3/(1+1.4*1) \; $f1*((1-$f5)*3+$f5*5.4) \; sqrt($f2/127*0.35*pow($f4 \, 2)) \; $f3/(1+1.4*2) \; $f1*((1-$f5)*4+$f5*8.93) \; sqrt($f2/127*0.2*pow($f4 \, 3)) \; $f3/(1+1.4*3) \; $f1+$f6 \; $f1*((1-$f5)*2+$f5*2.76)+$f6*1.3;
#X obj 20 150 mtof;
#X msg 400 100 2700;
#X obj 400 40 loadbang;
#X obj 400 70 r bell-dec;
#X msg 520 100 0.6;
