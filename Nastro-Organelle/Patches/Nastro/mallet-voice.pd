#N canvas 40 40 1600 900 12;
#X text 20 5 mallet-voice: modal struck instruments - up to 7 resonators from the tables mltr / mlta / mltd / mltt - half-sine strike - click;
#X obj 20 40 inlet;
#X obj 20 55 t l l;
#X obj 120 85 unpack f f;
#X obj 20 70 unpack f f;
#X obj 20 130 moses 1;
#X obj 120 130 f;
#X obj 300 190 f 100;
#X obj 1450 10 v mltbase;
#X obj 1510 10 v mltclick;
