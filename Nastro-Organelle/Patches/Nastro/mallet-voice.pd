#X obj 20 300 expr 2*exp(-6.9078/(if($f4>0 \, min($f4 \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1))))) \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1)))))*$f3))*cos((6.28319*($f1*mltr[0]+mltt[0])/$f3)) \; -exp(-6.9078/(if($f4>0 \, min($f4 \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1))))) \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1)))))*$f3))*exp(-6.9078/(if($f4>0 \, min($f4 \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1))))) \, max(0.001 \, mltbase*$f2*mltd[0]*min(3 \, max(0.3 \, sqrt(220/$f1)))))*$f3)) \; if(($f1*mltr[0]+mltt[0])<0.45*$f3 \, mltlevel*mlta[0]*sin((6.28319*($f1*mltr[0]+mltt[0])/$f3)) \, 0);
