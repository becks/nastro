#X obj 1300 950 expr max(0 \, ($f1-100)-(-2-$f2*28))*0.75 \; if(max(0 \, ($f1-100)-(-2-$f2*28))*0.75>$f4 \, 5+45*$f3 \, 50+750*$f3) \; pow(10 \, ($f2*8-max(0 \, ($f1-100)-(-2-$f2*28))*0.75)/20);
