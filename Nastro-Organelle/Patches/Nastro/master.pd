#N canvas 40 40 1300 900 12;
#X text 20 10 master: tape tracks (sends) -> delay + reverb. Live synth and drums stay dry. The tape records the dry synth.;
#X obj 20 50 catch~ synth-bus;
#X obj 200 50 catch~ tape-busL;
#X obj 330 50 catch~ tape-busR;
#X obj 200 70 catch~ fxd-tape;
#X obj 330 70 catch~ fxr-tape;
#X obj 20 90 s~ tape-in;
#X obj 200 90 +~;
#X obj 330 90 +~;
#X obj 20 820 *~ 1;
#X obj 200 820 *~ 1;
#X obj 20 850 *~;
#X obj 200 850 *~;
