#N canvas 40 40 1600 900 12;
#X text 20 5 meter: master output lights on the MIX page title row - L and R 12 segments + LIM;
#X obj 20 30 table mtcur 3;
#X obj 20 120 expr $f1==3 && $f2==0;
#X obj 20 90 t f;
#X obj 20 60 r mode;
#X obj 120 90 t b f;
#X obj 120 60 r mix-page;
#X obj 20 150 metro 100;
#X obj 20 180 t b b b b;
#X obj 300 60 r mt-reset;
#X msg 300 90 \; mtcur 0 0 0 0;
#X obj 1200 180 f 0;
#X msg 1300 150 1;
#X obj 1200 210 sel 1;
#X msg 1300 210 0;
#X msg 1200 240 \; oscOut sendtyped /oled/gFlip i 3;
#X obj 20 220 f 0;
#X obj 80 190 r nst-outL;
#X obj 20 250 expr ($f1>=70)+($f1>=73)+($f1>=76)+($f1>=79)+($f1>=82)+($f1>=85)+($f1>=88)+($f1>=91)+($f1>=94)+($f1>=96)+($f1>=98)+($f1>=99.5);
#X obj 20 280 expr abs(max($f1 \,  mtcur[0]-1)-mtcur[0]) \;  min(max($f1 \,  mtcur[0]-1) \,  mtcur[0]) \;  max($f1 \,  mtcur[0]-1)>mtcur[0] \;  max($f1 \,  mtcur[0]-1);
#X obj 20 290 pack f f f f;
#X obj 20 300 unpack f f f f;
#X obj 220 310 tabwrite mtcur;
#X msg 220 280 0;
#X obj 220 250 loadbang;
#X obj 20 430 pack f f;
#X obj 120 370 f;
#X obj 170 370 + 1;
#X obj 20 340 moses 1;
#X obj 70 360 t f b;
#X obj 70 390 until;
#X obj 120 400 expr 34+$f1*7;
#X msg 20 460 \; oscOut sendtyped /oled/gFillArea iiiiii 3 \$1 1 6 3 \$2;
#X obj 420 220 f 0;
#X obj 480 190 r nst-outR;
#X obj 420 250 expr ($f1>=70)+($f1>=73)+($f1>=76)+($f1>=79)+($f1>=82)+($f1>=85)+($f1>=88)+($f1>=91)+($f1>=94)+($f1>=96)+($f1>=98)+($f1>=99.5);
#X obj 420 280 expr abs(max($f1 \,  mtcur[1]-1)-mtcur[1]) \;  min(max($f1 \,  mtcur[1]-1) \,  mtcur[1]) \;  max($f1 \,  mtcur[1]-1)>mtcur[1] \;  max($f1 \,  mtcur[1]-1);
#X obj 420 290 pack f f f f;
#X obj 420 300 unpack f f f f;
#X obj 620 310 tabwrite mtcur;
#X msg 620 280 1;
#X obj 620 250 loadbang;
#X obj 420 430 pack f f;
#X obj 520 370 f;
#X obj 570 370 + 1;
#X obj 420 340 moses 1;
#X obj 470 360 t f b;
#X obj 470 390 until;
#X obj 520 400 expr 34+$f1*7;
#X msg 420 460 \; oscOut sendtyped /oled/gFillArea iiiiii 3 \$1 5 6 3 \$2;
#X obj 820 220 f 0;
#X obj 880 190 < 0.97;
#X obj 880 160 r nst-lim-gain;
#X obj 820 250 expr $f1;
#X obj 820 280 expr abs($f1-mtcur[2]) \;  min($f1 \,  mtcur[2]) \;  $f1>mtcur[2] \;  $f1;
#X obj 820 290 pack f f f f;
#X obj 820 300 unpack f f f f;
#X obj 1020 310 tabwrite mtcur;
#X msg 1020 280 2;
