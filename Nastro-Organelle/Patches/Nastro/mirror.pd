#N canvas 40 40 900 600 12;
#X text 20 5 mirror: copy of the OLED to a computer - menu SCHERMO SU MAC toggles it - mirror.txt = its IP address;
#X obj 20 30 text define nst-mirror;
#X obj 150 450 netsend -u;
#X obj 20 90 f 0;
#X obj 20 120 == 0;
#X obj 20 60 r nst-mirror-toggle;
#X obj 20 135 t f f;
#X obj 20 150 sel 1 0;
#X obj 20 180 t b b;
#X msg 120 180 \; nst-mirror clear \; nst-mirror read mirror.txt;
#X obj 20 210 text size nst-mirror;
#X obj 20 240 moses 1;
#X obj 20 270 t b b;
#X msg 120 300 0;
#X msg 20 300 \; nst-proj-status symbol MANCA-MIRROR.TXT \; nst-mirror-on 0;
#X msg 150 255 0;
#X obj 150 280 text get nst-mirror;
#X msg 150 310 connect \$1 9123;
#X obj 300 180 t b b;
#X msg 300 210 disconnect;
#X msg 400 210 \; nst-proj-status symbol SCHERMO-OFF \; nst-mirror-on 0;
#X obj 300 480 spigot;
#X obj 150 480 sel 1;
#X obj 150 510 delay 200;
#X msg 250 510 \; nst-proj-status symbol SCHERMO-ON \; nst-mirror-on 1;
#X msg 150 540 \; nst-redraw bang;
#X obj 300 390 list prepend send;
#X obj 300 420 list trim;
#X obj 300 360 r oscOut;
#X obj 500 390 list prepend send /led;
#X obj 500 360 r led;
#X connect 5 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 6 0;
#X connect 6 1 3 1;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 1 9 0;
#X connect 8 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 1 13 0;
#X connect 13 0 3 1;
#X connect 12 0 14 0;
#X connect 11 1 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 2 0;
#X connect 7 1 18 0;
#X connect 18 1 19 0;
#X connect 19 0 2 0;
#X connect 18 0 20 0;
#X connect 2 0 21 1;
#X connect 2 0 22 0;
#X connect 22 0 23 0;
#X connect 22 0 24 0;
#X connect 23 0 25 0;
#X connect 28 0 26 0;
#X connect 26 0 27 0;
#X connect 30 0 29 0;
#X connect 29 0 27 0;
#X connect 27 0 21 0;
#X connect 21 0 2 0;
