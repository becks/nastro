#N canvas 40 40 900 700 12;
#X text 20 5 smpl-voice: plays the sample between smp-s0 and smp-s1 - pitched from C4 = original;
#X obj 20 40 inlet;
#X obj 20 70 t l l;
#X obj 700 600 switch~;
#X msg 800 570 0;
#X obj 800 540 loadbang;
#X obj 700 540 delay;
#X msg 760 510 1;
#X msg 820 510 stop;
#X obj 700 480 f 1000;
#X obj 700 510 + 300;
#X obj 900 420 r smp-rel;
#X obj 700 420 unpack f f;
#X obj 700 450 moses 1;
#X obj 760 480 t b b;
#X obj 700 465 t b;
#X obj 250 100 unpack f f;
#X obj 250 130 expr pow(2 \, ($f1-60)/12);
#X obj 250 160 f 1;
#X obj 20 100 unpack f f;
#X obj 20 130 moses 1;
#X obj 600 40 loadbang;
#X obj 600 70 samplerate~;
#X obj 250 220 expr $f2 \; max(64 \, $f3-$f2) \; if($f6 \, 1 \, $f1)*$f4/max(64 \, $f3-$f2) \; if($f5 \, 1e+09 \, max(1 \, max(64 \, $f3-$f2)/$f4*1000/if($f6 \, 1 \, $f1)-15))+3 \; if($f6 \, ($f1-1)*2205 \, 0);
#X obj 700 130 r smp-stretch;
#X obj 400 130 r smp-s0;
#X obj 500 130 r smp-s1;
#X obj 600 130 r smp-loop;
#X obj 20 160 t b;
