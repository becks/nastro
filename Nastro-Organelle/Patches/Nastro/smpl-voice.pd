#X obj 700 465 t b;
#X obj 250 100 unpack f f;
#X obj 250 130 expr pow(2 \, ($f1-60)/12);
#X obj 250 160 f 1;
#X obj 20 100 unpack f f;
#X obj 20 130 moses 1;
#X obj 600 40 loadbang;
#X obj 600 70 samplerate~;
#X obj 250 220 expr $f2 \; if($f5 \, max(64 \, min($f8 \, $f3)-$f2) \, 1e+09) \; if($f5 \, max($f2 \, min($f7 \, $f8-64))-$f2 \, 0) \; if($f5 \, max(64 \, min($f8 \, $f3)-max($f2 \, min($f7 \, $f8-64))) \, 1e+09) \; if($f6 \, 1 \, $f1) \; if($f5 \, 1e+09 \, max(1 \, max(64 \, $f3-$f2)/$f4*1000/if($f6 \, 1 \, $f1)-15))+3 \; if($f6 \, ($f1-1)*2205 \, 0);
