#N canvas 40 40 1200 700 12;
#X text 20 5 synth-air: engine 5 (ARIA). knobs: ATK / REL / Q / MOTO;
#X obj 20 40 r air-notes;
#X obj 160 40 r synth-panic;
#X obj 20 80 poly 4 1;
#X obj 20 110 pack f f f;
#X obj 20 140 clone -s 1 air-voice 4;
#X obj 20 180 *~ 1.8;
#X obj 20 210 clip~ -1 1;
#X obj 20 250 throw~ synth-bus;
#X obj 160 150 r synth-vol;
#X msg 160 180 \$1 20;
#X obj 160 210 line~;
#X obj 20 195 *~;
#X obj 300 40 r synth-engine;
#X obj 300 70 == 5;
#X obj 300 100 t f f;
#X obj 450 130 sel 1 0;
#X msg 450 160 1;
#X msg 400 160 stop;
