#N canvas 40 40 1800 1000 12;
#X text 20 5 synth-lfo: the active engine LFO - P1..P4 as syn-lfo-mod offsets every 30 ms - PITCH / VOL / trem on the engines bus;
#X obj 1500 20 v lfoE;
#X obj 1500 45 v lfoT;
#X obj 1500 70 v lfoTr;
#X obj 1500 95 v lfoR;
#X obj 1500 120 v lfoRr;
#X obj 1500 145 v lfoA;
#X obj 1500 170 v lfoD;
#X obj 1500 195 v lfoDr;
#X obj 20 50 unpack f f f f f;
#X obj 20 20 r lfo-cfg;
#X obj 400 80 t f f;
#X obj 400 110 expr int(min($f1 \, 0.999)*6);
#X obj 500 110 v lfoDr;
#X obj 400 140 v lfoD;
#X obj 300 110 v lfoA;
#X obj 200 80 t f f;
#X obj 200 110 expr 0.05*pow(200 \, $f1);
#X obj 260 140 v lfoRr;
#X obj 200 140 v lfoR;
#X obj 100 80 t f f;
#X obj 100 110 expr int(min($f1 \, 0.999)*9);
#X obj 160 170 v lfoTr;
#X obj 100 140 v lfoT;
#X obj 20 80 t b f;
#X obj 60 110 v lfoE;
#X obj 20 200 t b b b b;
#X obj 600 230 expr lfoE*10+if(lfoT>0 && lfoT!=7 && lfoD<4 \, lfoD \, 9);
