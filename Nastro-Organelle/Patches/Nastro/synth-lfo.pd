#X obj 600 290 t f b;
#X obj 600 320 f -1;
#X obj 600 350 t f f;
#X obj 700 380 % 10;
#X obj 700 410 t f f;
#X obj 800 440 < 4;
#X obj 600 380 / 10;
#X obj 600 410 int;
#X obj 600 470 pack f f;
