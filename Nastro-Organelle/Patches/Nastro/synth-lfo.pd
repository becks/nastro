#X msg 1000 430 \$1 30;
#X obj 1000 460 line~;
#X obj 1200 400 expr (lfoT==7 || (lfoT>0 && lfoD==4))*min(10 \, 1000*lfoA*if(lfoT==7 \, 0.0116 \, 0.0293)/(6.2832*lfoR));
#X msg 1200 430 \$1 50;
