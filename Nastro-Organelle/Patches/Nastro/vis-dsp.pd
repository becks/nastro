#N canvas 40 40 800 500 12;
#X text 20 5 vis-dsp: the output (after the limiter) in mono - level for WAVE - scope - FFT;
#X obj 20 30 r vis-on;
#X obj 20 60 switch~;
#X obj 20 100 r~ alb-L;
#X obj 150 100 r~ alb-R;
#X obj 20 130 +~;
#X obj 20 160 *~ 0.5;
#X obj 300 190 env~ 1024 512;
#X obj 300 220 s vis-env;
#X obj 20 220 vis-fft;
#X obj 150 220 vis-scope;
#X connect 1 0 2 0;
#X connect 3 0 5 0;
#X connect 4 0 5 1;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 6 0 9 0;
