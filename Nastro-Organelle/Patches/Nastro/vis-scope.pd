#N canvas 40 40 800 400 12;
#X text 20 5 vis-scope: at 1/8 of the sample rate - y = 32 - 28 x - whole numbers 1..62 - 44 values into visy;
#X obj 20 30 block~ 64 1 0.125;
#X obj 20 60 inlet~;
#X obj 20 90 *~ -28;
#X obj 20 120 +~ 32;
#X obj 20 150 clip~ 1 62;
#X obj 120 180 wrap~;
#X obj 20 210 -~;
#X obj 20 240 tabwrite~ visy;
#X obj 150 210 r vis-scope-bang;
