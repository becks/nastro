#N canvas 40 40 1500 1000 12;
#X text 20 5 drum: 24 slices of drums.wav on the keys. knobs edit the last played key: 1 pitch / 2 length / 3 tone / 4 level;
#X text 20 25 replace drums.wav with your own file: it is split into 24 equal slices;
#X obj 20 50 table dk1 24;
#X obj 130 50 table dk2 24;
#X obj 240 50 table dk3 24;
#X obj 350 50 table dk4 24;
#X obj 470 50 table drums;
#X obj 570 50 table dwave 42;
#X obj 20 90 loadbang;
#X obj 20 120 t b b b;
#X msg 200 120 \; dk1 const 0.5 \; dk2 const 1 \; dk3 const 1 \; dk4 const 0.8;
#X msg 20 150 read -resize drums.wav drums;
#X obj 20 180 soundfiler;
#X obj 20 210 expr int($f1/24);
#X obj 20 240 t f f f f;
#X obj 160 270 f;
#X obj 380 150 samplerate~;
#X obj 600 90 r drum-notes;
#X obj 600 120 unpack f f;
#X obj 700 150 > 0;
#X obj 600 180 spigot;
#X obj 600 210 expr min(23 \, max(0 \, $f1-60));
#X obj 600 240 t f f;
#X obj 600 300 expr $f1*$f2 \; $f2 \; $f2/$f3*1000/pow(2 \, floor((dk1[$f1]-0.5)*24+0.5)/12) \; max(1 \, min(dk2[$f1] \, 1)*$f2/$f3*1000/pow(2 \, floor((dk1[$f1]-0.5)*24+0.5)/12)-15) \; dk4[$f1]*1.2 \; 100*pow(2 \, dk3[$f1]*8);
#X obj 600 340 pack f f f f f f;
#X obj 800 340 f;
#X obj 840 340 + 1;
#X obj 800 370 % 6;
#X obj 600 400 list prepend 0;
#X obj 600 370 t l b;
#X obj 600 430 clone -s 0 drum-voice 6;
#X obj 600 470 *~ 0.5;
#X obj 600 500 throw~ synth-bus;
#X obj 900 240 f;
#X obj 900 270 t f f f f f f;
#X obj 800 240 change -1;
#X obj 900 330 tabwrite dk1;
#X obj 1010 330 tabwrite dk2;
#X obj 1120 330 tabwrite dk3;
#X obj 1230 330 tabwrite dk4;
#X obj 1100 270 expr dk1[$f1] \; dk2[$f1] \; dk3[$f1] \; dk4[$f1];
#X obj 1100 300 pack f f f f;
#X msg 1100 360 \; pkval 4 \$1 \$2 \$3 \$4 \; pkpick 4 0 0 0 0;
#X obj 900 400 r drum-knob;
#X obj 900 430 route 1 2 3 4;
#X msg 1350 430 1;
#X obj 900 470 t b b b f;
#X msg 900 500 42;
#X obj 900 530 until;
#X obj 900 560 f;
#X obj 950 560 + 1;
#X msg 980 530 0;
#X obj 900 590 t f f;
#X obj 900 620 expr $f2*$f3+int($f1*$f3/42) \; max(1 \, int($f3/42));
#X obj 900 680 array max drums;
#X obj 1050 680 array min drums;
#X obj 900 650 t f f;
#X obj 900 720 expr int(max($f1 \, -$f2)*13);
#X obj 900 750 tabwrite dwave;
#X obj 20 600 r mode;
#X obj 20 630 t f f;
#X obj 20 660 == 1;
#X obj 20 690 metro 50;
#X obj 120 600 r nst-redraw;
#X obj 20 720 f 1;
#X obj 20 750 sel 1;
#X obj 20 780 t b b b b b;
#X msg 120 780 0;
#X msg 150 820 \; oscOut sendtyped /oled/gShowInfoBar ii 3 0 \; oscOut sendtyped /oled/gClear ii 3 1 \; oscOut sendtyped /oled/gPrintln iiiiis 3 1 1 8 1 DRUM \; oscOut sendtyped /oled/gLine iiiiii 3 0 45 127 45 1 \; oscOut sendtyped /oled/gPrintln iiiiis 3 1 47 8 1 PIT \; oscOut sendtyped /oled/gPrintln iiiiis 3 33 47 8 1 LEN \; oscOut sendtyped /oled/gPrintln iiiiis 3 65 47 8 1 TON \; oscOut sendtyped /oled/gPrintln iiiiis 3 97 47 8 1 LVL;
#X msg 300 860 \; oscOut sendtyped /oled/gPrintln iiiiisi 3 40 1 8 1 key \$1;
#X obj 300 830 + 1;
#X obj 300 800 t b;
#X obj 500 800 t b b;
#X msg 500 830 42;
#X obj 500 860 until;
#X obj 500 890 f;
#X obj 550 890 + 1;
#X msg 580 860 0;
#X obj 500 920 t f f;
#X obj 500 950 expr 1+$f1*3 \; 26-dwave[$f1] \; 2*dwave[$f1]+1;
#X obj 500 980 pack f f f;
#X msg 500 1010 \; oscOut sendtyped /oled/gFillArea iiiiii 3 \$1 \$2 2 \$3 1;
#X obj 800 800 t b;
#X obj 800 860 expr floor((dk1[$f1]-0.5)*24+0.5) \; int(min(dk2[$f1] \, 1)*100) \; int(dk3[$f1]*100) \; int(dk4[$f1]*100) \; 1+int(min(dk2[$f1] \, 1)*125);
#X obj 800 830 f;
#X obj 800 890 pack f f f f f;
#X msg 800 920 \; oscOut sendtyped /oled/gLine iiiiii 3 \$5 10 \$5 42 1 \; oscOut sendtyped /oled/gPrintln iiiiif 3 1 55 8 1 \$1 \; oscOut sendtyped /oled/gPrintln iiiiif 3 33 55 8 1 \$2 \; oscOut sendtyped /oled/gPrintln iiiiif 3 65 55 8 1 \$3 \; oscOut sendtyped /oled/gPrintln iiiiif 3 97 55 8 1 \$4 \; oscOut sendtyped /oled/gFlip i 3;
