#X text 20 500 knob router: knobs go to the active mode as [knob# value];
#X obj 20 530 r knob1;
#X obj 20 560 list prepend 1;
#X obj 140 530 r knob2;
#X obj 140 560 list prepend 2;
#X obj 260 530 r knob3;
#X obj 260 560 list prepend 3;
#X obj 380 530 r knob4;
#X obj 380 560 list prepend 4;
#X obj 20 610 list prepend 0;
#X text 560 500 pickup: knob controls the parameter only after crossing its current value;
#X obj 560 530 table pkval 44;
#X obj 680 530 table pkpick 44;
#X obj 800 530 table pkphys 4;
#X obj 20 590 t l l l;
#X obj 200 590 expr if(pkpick[$f3*4+$f1-1] || abs($f2-pkval[$f3*4+$f1-1])<0.02 || (pkphys[$f1-1]>=0 && (pkphys[$f1-1]-pkval[$f3*4+$f1-1])*($f2-pkval[$f3*4+$f1-1])<=0) \, 1 \, 0);
#X obj 560 590 expr $f2 \; $f1-1;
#X obj 560 620 tabwrite pkphys;
#X obj 20 640 spigot;
#X obj 20 670 t l l;
#X obj 200 700 expr $f2 \; $f3*4+$f1-1;
#X obj 200 730 t f b;
#X msg 260 760 1;
#X obj 200 790 tabwrite pkval;
#X obj 320 790 tabwrite pkpick;
#X obj 560 660 expr if($f1==3 && $f2==1 \, 5 \, if($f1==0 && $f3>0 \, if($f3==4 \, 10 \, 5+$f3) \, if($f1==4 && $f4==1 \, 9 \, $f1)));
