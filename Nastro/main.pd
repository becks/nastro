#X obj 560 660 expr if($f1==5 \, 12 \, 0) + if($f1==5 \, 0 \, if($f1==3 && $f2==0 && $f5==1 \, 11 \, if($f1==0 && $f5==1 \, 13 \, if($f1==1 && $f5==1 \, 14 \, if($f1==3 && $f2==4 \, if($f5==1 \, 28 \, 27) \, if($f1==3 && $f2==3 \, 22 \, if($f1==3 && $f2==2 \, if($f5==1 \, 21 \, 20) \, if($f1==3 && $f2==1 \, if($f5==1 \, 16 \, 5) \, if($f1==0 && $f3>0 \, if($f3==4 \, 10 \, if($f3>=7 \, 16+$f3 \, if($f3>=5 \, 13+$f3 \, 5+$f3))) \, if($f1==4 && $f4==1 \, 9 \, if($f1==4 && $f4==2 \, 15 \, if($f1==4 && $f4==3 \, 17 \, $f1))))))))))));
