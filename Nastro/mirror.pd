#N canvas 40 40 900 600 12;
#X text 20 5 mirror: copy of the OLED to a computer - menu SCREEN TO MAC toggles it - mirror.txt = its IP address;
#X obj 20 30 text define nst-mirror;
#X obj 150 450 netsend -u;
#X obj 20 90 f 0;
#X obj 20 120 == 0;
#X obj 20 60 r nst-mirror-toggle;
#X obj 20 135 t f f;
#X obj 20 150 sel 1 0;
#X obj 20 180 t b b;
#X msg 120 180 \; nst-mirror clear \; nst-mirror read mirror.txt;
#X obj 20 210 text size nst-mirror;
#X obj 20 240 moses 1;
#X obj 20 270 t b b;
#X msg 120 300 0;
#X msg 20 300 \; nst-proj-status symbol NO-MIRROR.TXT \; nst-mirror-on 0;
#X msg 150 255 0;
#X obj 150 280 text get nst-mirror;
#X msg 150 310 connect \$1 9123;
#X obj 300 180 t b b;
#X msg 300 210 disconnect;
#X msg 400 210 \; nst-proj-status symbol SCREEN-OFF \; nst-mirror-on 0;
#X obj 300 480 spigot;
#X obj 150 480 sel 1;
#X obj 150 510 delay 200;
#X msg 250 510 \; nst-proj-status symbol SCREEN-ON \; nst-mirror-on 1;
#X msg 150 540 \; nst-redraw bang;
#X obj 300 390 list prepend send;
#X obj 300 420 list trim;
#X obj 300 330 route sendtyped;
#X obj 300 300 r oscOut;
#X obj 560 330 route /oled/gFrame /oled/gWaveform;
