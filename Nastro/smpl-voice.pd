#N canvas 40 40 900 700 12;
#X text 20 5 smpl-voice: plays the sample between smp-s0 and smp-s1 - pitched from C4 = original;
#X obj 20 40 inlet;
#X obj 20 70 t l l;
#X obj 250 100 unpack f f;
#X obj 250 130 expr pow(2 \, ($f1-60)/12);
#X obj 250 160 f 1;
#X obj 20 100 unpack f f;
#X obj 20 130 moses 1;
#X obj 600 40 loadbang;
#X obj 600 70 samplerate~;
#X obj 250 220 expr $f2 \; max(64 \, $f3-$f2) \; $f1*$f4/max(64 \, $f3-$f2) \; if($f5 \, 1e+09 \, max(1 \, max(64 \, $f3-$f2)/$f4*1000/$f1-15))+3;
#X obj 400 130 r smp-s0;
#X obj 500 130 r smp-s1;
#X obj 600 130 r smp-loop;
#X obj 20 160 t b;
#X msg 400 300 0 1.5 \, 1 3 3 \, 0 15 \$1;
#X obj 400 360 vline~;
#X obj 250 260 pack f f f;
#X obj 250 290 list;
#X obj 150 260 delay 1.5;
#X obj 250 320 unpack f f f;
#X obj 20 460 tabread4~ smpl;
#X obj 150 400 phasor~;
#X obj 150 430 *~ 0;
#X msg 250 360 0;
#X obj 250 340 t b f;
#X obj 20 250 f 300;
#X obj 80 220 r smp-rel;
#X obj 20 190 t b;
#X msg 20 280 0 \$1;
#X obj 20 500 *~;
#X obj 20 540 outlet~;
