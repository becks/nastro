#N canvas 40 40 1300 900 12;
#X text 20 5 tempo: knobs (AUX+E) 1 BPM 60-200 / 2 metronome level / 3 loop snap free-beat-bar / 4 delay sync;
#X text 20 25 beat length is rounded to whole 64-sample blocks so tempo-snapped loops stay sample-exact;
#X obj 20 60 loadbang;
#X obj 20 90 t b b;
#X obj 120 120 samplerate~;
#X obj 120 150 t f f f;
#X obj 300 60 r tempo-knob;
#X msg 300 90 1 0.4286 \, 2 0 \, 3 1 \, 4 0;
