#N canvas 40 40 1200 700 12;
#X text 20 5 toast: [s nst-toast] 1-4 words -> a box over any page for 1.5 s (redrawn after each page flip);
#X obj 20 40 r nst-toast;
#X obj 20 70 list;
#X obj 20 100 t b l l;
#X obj 300 160 list;
#X obj 150 130 list length;
#X obj 150 160 sel 1 2 3 4;
#X obj 300 220 list prepend;
#X msg 150 190 list sendtyped /oled/gPrintln iiiiis;
#X msg 270 190 list sendtyped /oled/gPrintln iiiiiss;
#X msg 390 190 list sendtyped /oled/gPrintln iiiiisss;
#X msg 510 190 list sendtyped /oled/gPrintln iiiiissss;
#X msg 20 160 1;
#X obj 100 190 delay 1500;
#X obj 20 130 t b b b;
#X obj 100 220 t b b;
#X msg 200 250 0;
#X msg 100 250 \; nst-redraw bang;
#X obj 20 400 t b b b b b b;
#X obj 600 400 spigot 1;
#X msg 600 440 0;
#X msg 660 440 1;
#X msg 20 440 \; oscOut sendtyped /oled/gFillArea iiiiii 3 6 19 116 24 0;
#X msg 20 470 \; oscOut sendtyped /oled/gBox iiiiii 3 7 20 114 22 1;
#X obj 300 470 list prepend 3 13 27 8 1;
#X obj 300 530 list trim;
#X obj 300 560 s oscOut;
#X msg 20 500 \; oscOut sendtyped /oled/gFlip i 3;
#X obj 600 300 r oscOut;
#X obj 600 330 route sendtyped;
#X obj 600 360 route /oled/gFlip;
#X obj 600 470 t b;
#X obj 600 500 spigot;
