# exec'd from gen.py: SMPL engine voice (smpl-voice.pd) and the sample recorder (smpl.pd)
# The engine wrapper synth-smpl.pd is built by gensynth.py's generic engine() builder.
SMAX = 441000   # 10 s at 44.1 kHz

# ---------------------------------------------------------------- smpl-voice.pd
# De-click: on note-on the voice first fades out (1.5 ms), then (after 1.5 ms) jumps the
# playhead, then fades in. START/END come in as zero-crossing-snapped sample indices
# (smp-s0 / smp-s1, computed in smpl.pd).
v = Patch(900, 700)
v.text(20, 5, "smpl-voice: plays the sample between smp-s0 and smp-s1 - pitched from C4 = original")
inl = v.obj(20, 40, "inlet")
tll = v.obj(20, 70, "t l l")
upn = v.obj(250, 100, "unpack f f")
rateE = v.obj(250, 130, "expr pow(2 \\, ($f1-60)/12)")
fRate = v.obj(250, 160, "f 1")
v.c(inl, tll); v.c(tll, upn, 1); v.c(upn, rateE); v.c(rateE, fRate, 0, 1)
upv = v.obj(20, 100, "unpack f f")
mos = v.obj(20, 130, "moses 1")
v.c(tll, upv, 0); v.c(upv, mos, 1)
lb = v.obj(600, 40, "loadbang")
srt = v.obj(600, 70, "samplerate~")
v.c(lb, srt)
# onset, length, phasor frequency, one-shot hold (from the note start)
onE = v.obj(250, 220,
            "expr $f2 \; max(64 \\, $f3-$f2) \; $f1*$f4/max(64 \\, $f3-$f2) \; "
            "if($f5 \\, 1e+09 \\, max(1 \\, max(64 \\, $f3-$f2)/$f4*1000/$f1-15))+3")
v.c(v.obj(400, 130, "r smp-s0"), onE, 0, 1)
v.c(v.obj(500, 130, "r smp-s1"), onE, 0, 2)
v.c(srt, onE, 0, 3)
v.c(v.obj(600, 130, "r smp-loop"), onE, 0, 4)
onT = v.obj(20, 160, "t b")
v.c(mos, onT, 1); v.c(onT, fRate); v.c(fRate, onE)
# envelope now: fade out 1.5 ms, fade in after 3 ms, one-shot fade at the end
env = v.msg(400, 300, "0 1.5 \\, 1 3 3 \\, 0 15 \\$1")
v.c(onE, env, 3)
venv = v.obj(400, 360, "vline~")
v.c(env, venv)
# playhead jump 1.5 ms later (when the voice is silent)
pk = v.obj(250, 260, "pack f f f")
v.c(onE, pk, 2, 2); v.c(onE, pk, 1, 1); v.c(onE, pk, 0, 0)
held = v.obj(250, 290, "list")
v.c(pk, held, 0, 1)
dl = v.obj(150, 260, "delay 1.5")
v.c(onT, dl)
v.c(dl, held)
apU = v.obj(250, 320, "unpack f f f")
v.c(held, apU)
rd = v.obj(20, 460, "tabread4~ smpl")
ph = v.obj(150, 400, "phasor~")
ln = v.obj(150, 430, "*~ 0")
z = v.msg(250, 360, "0")
apT = v.obj(250, 340, "t b f")
v.c(apU, ph, 2, 0)            # frequency
v.c(apU, ln, 1, 1)            # length
v.c(apU, apT, 0); v.c(apT, rd, 1, 1); v.c(apT, z, 0); v.c(z, ph, 0, 1)   # onset, then phase 0
v.c(ph, ln); v.c(ln, rd)
# note off: release
fRel = v.obj(20, 250, "f 300")
v.c(v.obj(80, 220, "r smp-rel"), fRel, 0, 1)
offT = v.obj(20, 190, "t b")
v.c(mos, offT, 0); v.c(offT, fRel)
relM = v.msg(20, 280, "0 \\$1")
v.c(fRel, relM); v.c(relM, venv)
vca = v.obj(20, 500, "*~")
v.c(rd, vca, 0, 0); v.c(venv, vca, 0, 1)
v.c(vca, v.obj(20, 540, "outlet~"))
v.save("smpl-voice.pd")

# ---------------------------------------------------------------- smpl.pd (recorder)
r = Patch(1100, 700)
r.text(20, 5, "smpl: sample recorder. AUX+E5 records the audio input / AUX+F5 records Nastro's own output")
r.text(20, 25, "press the same key again to stop (max 10 s). AUX+A saves smpl.wav next to the patch. AUX+F#5 = input monitor on/off")
r.obj(20, 50, f"table smpl {SMAX}")
# sources: input (L+R)/2 or master
inL = r.obj(20, 100, "r~ inL"); inR = r.obj(120, 100, "r~ inR")
inS = r.obj(20, 130, "+~"); inG = r.obj(20, 160, "*~ 0")
r.c(inL, inS, 0, 0); r.c(inR, inS, 0, 1); r.c(inS, inG)
mst = r.obj(250, 100, "r~ nst-master")
mG = r.obj(250, 160, "*~ 0")
r.c(mst, mG)
tw = r.obj(20, 220, f"tabwrite~ smpl")
r.c(inG, tw); r.c(mG, tw)
# keys
rak = r.obj(500, 60, "r aux-key")
ks = r.obj(500, 90, "sel 76 77")
r.c(rak, ks)
recF = r.obj(600, 150, "f")          # 1 while recording
srcIn = r.msg(500, 120, "0.5 0")     # gains: input, master
srcMs = r.msg(580, 120, "0 1")
# pressing either key: if recording -> stop, else start with that source
gate = r.obj(500, 180, "t b l")
r.c(ks, srcIn, 0); r.c(ks, srcMs, 1); r.c(srcIn, gate); r.c(srcMs, gate)
srcStore = r.obj(700, 210, "list")
r.c(gate, srcStore, 1, 1)
r.c(gate, recF, 0)
recS = r.obj(600, 180, "sel 0 1")
r.c(recF, recS)
# start
stT = r.obj(500, 240, "t b b b b")
r.c(recS, stT, 0)
r.c(stT, srcStore, 3)
srcU = r.obj(700, 240, "unpack f f")
r.c(srcStore, srcU); r.c(srcU, inG, 0, 1); r.c(srcU, mG, 1, 1)
resz = r.msg(500, 300, f"\\; smpl resize {SMAX} \\; smp-recording 1")
r.c(stT, resz, 2)
tm = r.obj(800, 300, "timer")
r.c(stT, tm, 1, 0)                   # reset the timer at start
auto = r.obj(650, 300, f"delay {SMAX // 44.1:.0f}")
r.c(stT, auto, 1)
one = r.msg(600, 330, "1")
r.c(stT, one, 0); r.c(one, recF, 0, 1)
r.c(stT, tw, 0)                      # bang = start writing at 0  (last, after source + resize)
# stop (key again, or the 10 s auto stop)
spT = r.obj(800, 240, "t b b b b")
r.c(recS, spT, 1); r.c(auto, spT)
stopM = r.msg(800, 360, "stop")
r.c(spT, stopM, 3); r.c(stopM, tw)
cancel = r.msg(900, 360, "stop")
r.c(spT, cancel, 2); r.c(cancel, auto)
srt = r.obj(1000, 60, "samplerate~")
r.c(r.obj(1000, 30, "loadbang"), srt)
lenE = r.obj(800, 420, f"expr min({SMAX} \\, max(64 \\, int($f1*$f2/1000)))")
r.c(srt, lenE, 0, 1)
r.c(spT, tm, 1, 1); r.c(tm, lenE)      # read the elapsed time
endM = r.msg(800, 450, "\\; smpl resize \\$1 \\; smp-len \\$1 \\; smp-recording 0")
r.c(lenE, endM)
zero = r.msg(950, 420, "0")
r.c(spT, zero, 0); r.c(zero, recF, 0, 1)
# silence the sources when not recording (saves nothing, but keeps tabwrite~ input quiet)
# --- save / load
sf = r.obj(20, 560, "soundfiler")
sv = r.msg(20, 520, "write -wave -bytes 2 smpl.wav smpl")
svk = r.obj(20, 460, "r aux-key")
svs = r.obj(20, 490, "sel 69")
r.c(svk, svs); r.c(svs, sv); r.c(sv, sf)
lbl = r.obj(250, 460, "loadbang")
lbT = r.obj(250, 490, "t b b")
dflt = r.msg(350, 520, f"\\; smp-len {SMAX}")
rdM = r.msg(250, 520, "read -resize smpl.wav smpl")
r.c(lbl, lbT); r.c(lbT, dflt, 1); r.c(lbT, rdM, 0); r.c(rdM, sf)
ldOK = r.obj(250, 590, "moses 1")
lenM = r.msg(300, 620, "\\; smp-len \\$1")
r.c(sf, ldOK); r.c(ldOK, lenM, 1)
# --- input monitor: AUX+F#5 toggles it, and it is on while sampling the input.
# The input goes to the instrument bus, so it is heard with the FX and can be recorded on tape.
monK = r.obj(1100, 100, "r aux-key")
monS = r.obj(1100, 130, "sel 78")
monF = r.obj(1100, 160, "f")
monN = r.obj(1100, 190, "== 0")
r.c(monK, monS); r.c(monS, monF); r.c(monF, monN); r.c(monN, monF, 0, 1)
monE = r.obj(1100, 260, "expr $f1 || $f2")
r.c(monN, monE, 0, 0)
recIn = r.obj(1200, 200, "> 0")
recInT = r.obj(1200, 230, "t b f")
r.c(srcU, recIn, 0); r.c(zero, recIn); r.c(recIn, recInT)
r.c(recInT, monE, 1, 1); r.c(recInT, monE, 0, 0)
monT = r.obj(1100, 290, "t f f")
r.c(monE, monT)
r.c(monT, r.obj(1200, 320, "s smp-monitor"), 1)
monM = r.msg(1100, 320, "\\$1 20")
monL = r.obj(1100, 350, "line~")
monG = r.obj(1000, 380, "*~")
monH = r.obj(1000, 410, "*~ 0.5")
r.c(monT, monM, 0); r.c(monM, monL); r.c(inS, monG, 0, 0); r.c(monL, monG, 0, 1); r.c(monG, monH)
r.c(monH, r.obj(1000, 440, "throw~ synth-bus"))
# --- START / END -> sample indices snapped to the next upward zero crossing (smp-s0 / smp-s1)
# recomputed 40 ms after the last change; the search looks at most 1024 samples ahead,
# 128 samples per scheduler tick, so it never makes a CPU spike.
W, CH = 1024, 128
fSt = r.obj(20, 700, "f 0"); fEn = r.obj(100, 700, "f 1"); fLn = r.obj(180, 700, f"f {SMAX}")
r.c(r.obj(20, 670, "r smp-start"), fSt, 0, 1)
r.c(r.obj(100, 670, "r smp-end"), fEn, 0, 1)
r.c(r.obj(180, 670, "r smp-len"), fLn, 0, 1)
deb = r.obj(300, 700, "delay 40")
debB = r.obj(300, 680, "t b")          # values must not reach [delay]'s left inlet (it would become the delay time)
r.c(debB, deb)
for nm in ("smp-start", "smp-end", "smp-len"):
    r.c(r.obj(300 + ("smp-start", "smp-end", "smp-len").index(nm) * 90, 650, f"r {nm}"), debB)
go = r.obj(300, 730, "t b b b")
r.c(deb, go)
rawE = r.obj(20, 790, "expr int(min($f1 \\, $f2)*$f3) \; min($f3 \\, int(max($f1 \\, $f2)*$f3))")
r.c(go, fLn, 2); r.c(fLn, rawE, 0, 2)
r.c(go, fEn, 1); r.c(fEn, rawE, 0, 1)
r.c(go, fSt, 0); r.c(fSt, rawE, 0, 0)


def searcher(x, raw_outlet, send):
    """raw index in -> first upward zero crossing within W samples (or raw) -> [s send]"""
    inT = r.obj(x, 830, "t b b b f")
    base = r.obj(x + 120, 860, "f")
    r.c(rawE, inT, raw_outlet)
    r.c(inT, base, 3, 1)
    found = r.obj(x + 200, 860, "f -1")
    rf = r.msg(x + 200, 830, "-1")
    i0 = r.msg(x + 280, 830, "0")
    cnt = r.obj(x, 920, "f")
    cnt1 = r.obj(x + 50, 920, "+ 1")
    r.c(inT, rf, 2); r.c(rf, found, 0, 1); r.c(inT, i0, 1); r.c(i0, cnt, 0, 1)
    chunk = r.obj(x, 860, "t b b")
    r.c(inT, chunk, 0)
    nM = r.msg(x + 60, 890, f"{CH}")
    un = r.obj(x + 60, 920 - 0, "until")
    r.c(chunk, nM, 1); r.c(nM, un); r.c(un, cnt); r.c(cnt, cnt1); r.c(cnt1, cnt, 0, 1)
    # test sample base+i
    idxE = r.obj(x, 950, "+")
    r.c(cnt, idxE)
    tE = r.obj(x, 980, "expr if($f1>=$f2-1 \\, 2 \\, if($f1>0 && smpl[max(0 \\, $f1-1)]<=0 && smpl[$f1]>0 \\, 1 \\, 0)) \; $f1")
    r.c(fLn, tE, 0, 1)
    tP = r.obj(x, 1010, "pack f f")
    r.c(idxE, tE); r.c(tE, tP, 1, 1); r.c(tE, tP, 0, 0)
    tR = r.obj(x, 1040, "route 1 2")
    r.c(tP, tR)
    hitT = r.obj(x, 1070, "t b f")
    r.c(tR, hitT, 0); r.c(hitT, found, 1, 1); r.c(hitT, un, 0, 1)        # found: remember, stop
    endT = r.obj(x + 80, 1070, "t b b")
    m2 = r.msg(x + 160, 1100, "-2")
    r.c(tR, endT, 1); r.c(endT, m2, 1); r.c(m2, found, 0, 1); r.c(endT, un, 0, 1)   # table end: stop
    # after each chunk: done if found, hit the end, or searched W samples
    chk = r.obj(x, 1130, "t b")
    r.c(chunk, chk, 0)
    stE = r.obj(x, 1160, f"expr if($f1>=0 \\, $f1 \\, if($f1==-2 || $f2>={W} \\, $f3 \\, -1))")
    fCnt = r.obj(x + 150, 1130, "f"); fBase = r.obj(x + 200, 1130, "f")
    r.c(cnt, fCnt, 0, 1); r.c(inT, fBase, 3, 1)
    chT = r.obj(x, 1190 - 0, "t b b b")
    r.c(chk, chT); r.c(chT, fBase, 2); r.c(fBase, stE, 0, 2); r.c(chT, fCnt, 1); r.c(fCnt, stE, 0, 1)
    r.c(chT, found, 0); r.c(found, stE)
    res = r.obj(x, 1220, "moses 0")
    r.c(stE, res)
    again = r.obj(x, 1250, "delay 1")
    r.c(res, again, 0); r.c(again, chunk)
    r.c(res, r.obj(x + 80, 1250, f"s {send}"), 1)
    # base -> adder (right inlet), so idx = base + i
    r.c(inT, idxE, 3, 1)


searcher(20, 0, "smp-s0")
searcher(450, 1, "smp-s1")
r.save("smpl.pd")
